import java.util.Arrays;
import java.util.Optional;

import org.openqa.selenium.By;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.devtools.DevTools;
import org.openqa.selenium.devtools.latest.network.model.ConnectionType;
import org.openqa.selenium.devtools.v149.network.Network;
import org.openqa.selenium.devtools.v149.network.Network;
import org.openqa.selenium.devtools.v149.network.model.NetworkConditions;

import io.opentelemetry.exporter.logging.SystemOutLogRecordExporter;

public class NetworkSpeed {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		ChromeDriver driver = new ChromeDriver();
		DevTools devTools = driver.getDevTools();
		devTools.createSession();
		devTools.send(Network.enable(Optional.empty(), Optional.empty(), Optional.empty(), Optional.empty(), Optional.empty()));
		
		//devTools.send(Network.emulateNetworkConditions(false, 3000, 20000, 100000, Optional.empty(),  Optional.empty(),  Optional.empty(),  Optional.empty()));
		
        		  
        		  devTools.send(Network.emulateNetworkConditionsByRule(
        				    false,
        				    Arrays.asList(
        				        new NetworkConditions(
        				            ".*",              // Apply to all URLs
        				            3000,              // Latency (milliseconds)
        				            20000,             // Download throughput (bytes/sec)
        				            100000,            // Upload throughput (bytes/sec)
        				            Optional.empty(),  // Connection type
        				            Optional.empty(),  // Packet loss
        				            Optional.empty(),  // Packet queue length
        				            Optional.empty()   // Packet reordering
        				        )
        				    )
        				));
        		  
        		  long startTime =System.currentTimeMillis();
        		  
        		  driver.get("https://rahulshettyacademy.com/angularAppdemo/");
        			driver.findElement(By.cssSelector("button[routerlink*='library']")).click();
        			
        			 long endTime =System.currentTimeMillis();
        			 System.out.println(endTime- startTime);
        			 driver.close();
        		  
	}
	
}
